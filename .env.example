PUBLIC_URL="https://itsmillertime.dev"
# adapter-node (production): max request body size (default 512K). Web Share Target POSTs are
# multipart image uploads — set at least ~16M so they clear before our app-level draft limit (15MB).
BODY_SIZE_LIMIT=16M
# Client/browser: in local dev, point at this site's /api proxy (same origin) for auth cookies.
# Production: the public CMS API URL.
PUBLIC_PAYLOAD_API_ENDPOINT="https://cms.itsmillertime.dev/api"
PUBLIC_PAYLOAD_URL="https://cms.itsmillertime.dev"
# Public media / gallery-images file URLs are rewritten to Cloudflare edge hosts:
#   https://media.itsmillertime.dev/…  and  https://gallery-images.itsmillertime.dev/…
# Local CMS when running cms-itsmillertime-dev (optional; used by client SDK dev fallback in sdk.ts).
PUBLIC_PAYLOAD_API_ENDPOINT_DEV="http://localhost:3000/api"
# For local Authentik login testing, set PUBLIC_PAYLOAD_URL to http://localhost:3000 as well.
# Proxying auth to production CMS from localhost causes OAuth state_mismatch
# (state cookie on :5173, callback on cms.itsmillertime.dev).
# Frontend login is on www (/account/login/authentik → /api/auth proxy).
# User settings link on the account security page.
PUBLIC_AUTHENTIK_URL="https://auth.itsmillertime.dev"
# Authentik callbacks in use: www and cms
#   https://www.itsmillertime.dev/api/auth/oauth2/callback/authentik
#   https://cms.itsmillertime.dev/api/auth/oauth2/callback/authentik
# Local: http://localhost:5173/api/auth/oauth2/callback/authentik
PAYLOAD_TYPES_URL=https://raw.githubusercontent.com/ChristopherLMiller/cms-itsmillertime-dev/refs/heads/main/src/payload-types.ts
CLOCKIFY_API_KEY=""
CLOCKIFY_WORKSPACE_ID=""
# Server-only Anthropic key for admin lightbox “Suggest with AI” alt text.
# Optional model override (default: claude-sonnet-5). Used until site-settings has a key/model.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
# Same 64-char hex value as CMS SETTINGS_ENCRYPTION_KEY. Decrypts site-settings secrets on GET.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=""
DISQUS_SHORTNAME=itsmillertimedev
PUBLIC_FACEBOOK_APP_ID=""

# Server-only direct CMS API (sdk.server, /api/payload cache, /api/[...path] and /api/auth proxy).
# Must include /api. Never point at the SvelteKit dev server — that causes SSR self-fetch loops.
# Auth must use this internal URL so Cloudflare cannot rewrite X-Forwarded-Host to cms.
PAYLOAD_INTERNAL_URL="http://127.0.0.1:3000/api"

# BoardGameGeek API Token
# Get your token from: https://boardgamegeek.com/wiki/page/BGG_XML_API2
BGG_API_TOKEN=your_boardgamegeek_api_token_here

# --- Medusa commerce (add-to-cart handoff) ---
# Medusa backend base URL (server-side use). Local: http://localhost:9000
MEDUSA_BACKEND_URL="http://localhost:9000"
# Publishable API key from the Medusa setup script (storefront-scoped).
MEDUSA_PUBLISHABLE_KEY=""
# Region id (US/USD) from the Medusa setup script.
MEDUSA_REGION_ID=""
# Public storefront base where the cart/checkout lives (cart cookie is shared with it).
PUBLIC_SHOP_URL="https://shop.itsmillertime.dev"
# Public storefront (menu Apps link; available to all visitors).
PUBLIC_STOREFRONT_URL="https://store.itsmillertime.dev"
# Medusa admin dashboard (menu Apps link; admins only).
PUBLIC_MEDUSA_ADMIN_URL="https://medusa.itsmillertime.dev/app"
# Coolify dashboard (menu Apps link; admins only).
PUBLIC_COOLIFY_URL="https://coolify.itsmillertime.dev"
# Plausible analytics (menu Apps link; admins only).
PUBLIC_PLAUSIBLE_URL="https://analytics.itsmillertime.dev"
