{
	"name": "www-itsmillertime-dev",
	"private": true,
	"version": "0.38.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm run fetch-payload-types && vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check-native --tsconfig ./tsconfig.json",
		"check:legacy": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && pnpm run lint:ox && pnpm run lint:svelte",
		"lint:ox": "oxlint --type-aware --tsconfig ./tsconfig.json .",
		"lint:svelte": "eslint \"**/*.svelte\"",
		"ci": "pnpm run check && pnpm run lint && pnpm run test",
		"fetch-payload-types": "tsx scripts/sync-payload-types.ts",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test": "vitest run --project=unit",
		"test:watch": "vitest --project=unit",
		"test:storybook": "vitest run --project=storybook",
		"test:coverage": "vitest run --project=unit --coverage"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.6.0",
		"@eslint/compat": "^2.1.1",
		"@storybook/addon-docs": "^10.6.7",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/addon-vitest": "^10.6.7",
		"@storybook/sveltekit": "^10.6.7",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vitest/browser-playwright": "^5.1.0",
		"@vitest/coverage-v8": "^5.1.0",
		"dotenv": "^18.0.10",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.7",
		"eslint-plugin-svelte": "^3.24.1",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2006",
		"playwright": "^1.65.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"storybook": "^10.6.7",
		"stylelint": "^18.0.0",
		"stylelint-config-standard": "^41.0.0",
		"stylelint-declaration-strict-value": "^1.13.0",
		"svelte": "^5.57.3",
		"svelte-bricks": "^0.5.0",
		"svelte-check": "^4.7.8",
		"svelte-check-native": "^1.11.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"packageManager": "pnpm@11.18.0",
	"dependencies": {
		"@js-temporal/polyfill": "^0.5.1",
		"@payloadcms/sdk": "^3.93.0",
		"@tanstack/query-async-storage-persister": "^5.107.1",
		"@tanstack/svelte-query": "^6.4.1",
		"@tanstack/svelte-query-persist-client": "^6.4.1",
		"better-auth": "^1.7.22",
		"highlight.js": "^11.12.0",
		"maplibre-gl": "^6.18.0",
		"media-chrome": "^4.19.4",
		"photoswipe": "^5.4.4",
		"qs-esm": "^8.0.2",
		"satori": "^0.33.5",
		"sharp": "^0.35.5"
	}
}
