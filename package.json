{
	"name": "www-itsmillertime-dev",
	"private": true,
	"version": "0.23.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm run fetch-payload-types && vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"ci": "pnpm run check && pnpm run lint && pnpm run test",
		"fetch-payload-types": "tsx scripts/sync-payload-types.ts",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test": "vitest run --project=unit",
		"test:watch": "vitest --project=unit",
		"test:storybook": "vitest run --project=storybook",
		"test:coverage": "vitest run --project=unit --coverage"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.2.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@storybook/addon-docs": "^10.5.5",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.5.5",
		"@storybook/sveltekit": "^10.5.5",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"dotenv": "^17.4.2",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.5.5",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"storybook": "^10.5.5",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-declaration-strict-value": "^1.11.1",
		"svelte": "^5.56.8",
		"svelte-bricks": "^0.5.0",
		"svelte-check": "^4.7.4",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	},
	"packageManager": "pnpm@11.18.0",
	"dependencies": {
		"@better-auth/passkey": "^1.6.25",
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@js-temporal/polyfill": "^0.5.1",
		"@payloadcms/sdk": "^3.87.0",
		"@tanstack/query-async-storage-persister": "^5.101.4",
		"@tanstack/svelte-query": "^6.1.38",
		"@tanstack/svelte-query-persist-client": "^6.1.38",
		"better-auth": "^1.6.25",
		"highlight.js": "^11.11.1",
		"maplibre-gl": "^6.1.0",
		"media-chrome": "^4.19.2",
		"photoswipe": "^5.4.4",
		"qs-esm": "^8.0.1",
		"satori": "^0.29.0",
		"sharp": "^0.35.3",
		"video.js": "^8.23.9",
		"videojs-youtube": "^3.0.1"
	}
}
